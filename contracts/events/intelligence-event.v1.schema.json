{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auratrade.local/contracts/events/intelligence-event.v1.schema.json",
  "title": "IntelligenceEvent",
  "description": "A validated market intelligence event (schema v1). Status: DESIGN, proposed in Phase 0. Decimals are strings to avoid binary floating point.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventId", "eventType", "instruments", "publishedAt", "ingestedAt",
    "processedAt", "dataLatency", "summary", "significance", "confidence", "evidence",
    "assumptions", "limitations", "visibility", "correlationId"
  ],
  "$defs": {
    "instant": { "type": "string", "format": "date-time" },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
    "eventType": {
      "enum": [
        "EARNINGS_RESULT", "DIVIDEND", "BONUS_SPLIT", "BUYBACK", "M_AND_A", "RESTRUCTURING", "MANAGEMENT_CHANGE",
        "CREDIT_RATING", "REGULATORY", "ORDER_WIN_CONTRACT", "CAPACITY_EXPANSION", "FUNDRAISE",
        "PLEDGE_CHANGE", "INSIDER_TRADE", "LITIGATION", "GUIDANCE", "OPERATIONAL_DISRUPTION",
        "GOVERNANCE_RED_FLAG", "PAYMENT_DEFAULT", "MACRO_RELEASE", "SECTOR_NEWS", "OTHER"
      ]
    },
    "citedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citations"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "citations": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]+$" }, "minItems": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "$ref": "#/$defs/eventType", "description": "Primary type (taxonomy v1.1, ADR 0033 point 12)." },
    "secondaryTypes": { "type": "array", "items": { "$ref": "#/$defs/eventType" }, "maxItems": 3, "uniqueItems": true },
    "regulatoryDirection": { "enum": ["ADVERSE", "FAVOURABLE", "NEUTRAL"], "description": "Required when eventType is REGULATORY." },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["isin", "symbol", "exchange", "role"],
        "properties": {
          "isin": { "$ref": "#/$defs/isin" },
          "symbol": { "type": "string", "maxLength": 32 },
          "exchange": { "enum": ["NSE", "BSE"] },
          "role": { "enum": ["PRIMARY", "AFFECTED"] }
        }
      }
    },
    "observedAt": { "$ref": "#/$defs/instant" },
    "publishedAt": { "$ref": "#/$defs/instant" },
    "ingestedAt": { "$ref": "#/$defs/instant" },
    "processedAt": { "$ref": "#/$defs/instant" },
    "dataLatency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["REALTIME", "DELAYED", "EOD"] },
        "delaySeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": { "$ref": "#/$defs/citedText" },
    "interpretation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "citations", "generatedBy"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 800 },
            "citations": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]+$" }, "minItems": 1 },
            "generatedBy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["agentVersion", "model", "tier", "promptVersion"],
              "properties": {
                "agentVersion": { "type": "string" },
                "model": { "type": "string" },
                "tier": { "enum": ["HEAVY", "LIGHT", "LOCAL"] },
                "promptVersion": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "marketContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOfSession", "abnormal"],
      "properties": {
        "asOfSession": { "type": "string", "format": "date" },
        "returnT0": { "$ref": "#/$defs/decimal" },
        "returnT1": { "$ref": "#/$defs/decimal" },
        "excessVsBenchmark": { "$ref": "#/$defs/decimal" },
        "volumeRatio": { "$ref": "#/$defs/decimal" },
        "abnormal": { "type": "boolean" }
      }
    },
    "significance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "components"],
      "properties": {
        "score": { "$ref": "#/$defs/decimal" },
        "components": { "type": "object", "additionalProperties": { "$ref": "#/$defs/decimal" } }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "kind", "ref", "licenceTag"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^E[0-9]+$" },
          "kind": { "enum": ["SOURCE_DOCUMENT", "PRICE_DATA", "INDICATOR"] },
          "ref": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "licenceTag": { "type": "string" },
          "excerpt": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "enum": ["GLOBAL", "TENANT"] },
        "tenantId": { "type": "string", "format": "uuid" }
      },
      "if": { "properties": { "scope": { "const": "TENANT" } } },
      "then": { "required": ["tenantId"] }
    },
    "correlationId": { "type": "string", "maxLength": 64 }
  },
  "if": { "properties": { "eventType": { "const": "REGULATORY" } } },
  "then": { "required": ["regulatoryDirection"] }
}
